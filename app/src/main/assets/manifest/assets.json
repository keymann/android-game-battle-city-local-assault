{
  "version": 3,
  "credits": "Battle City: Local Assault UI Asset Pack (프로젝트 자체 제작). HUD 비트맵 폰트만 Kenney Desert Shooter Pack (CC0).",
  "comment": "지형·탱크·이펙트·HUD 가 모두 한 팩에서 나오고 화풍이 같다. 그래서 아틀라스도 한 장이고 필터도 하나다. tools/build_atlas.py 가 만든다.",

  "atlases": {
    "game": {
      "image": "atlas/game.png",
      "descriptor": "atlas/game.xml",
      "type": "xml_subtexture",
      "filter": "nearest",
      "comment": "전부 픽셀아트다. 탱크는 4방향이 미리 그려져 있어 런타임 회전이 없다. 회전이 없으니 NEAREST 로 도트를 그대로 살린다."
    }
  },

  "world": {
    "blockPx": 64,
    "cellPx": 32,
    "cellsPerBlock": 2,
    "tankSizePx": 64,
    "tankSpritePx": 96,
    "comment": "block = 지형 타일 1장 = 탱크 차체 1대. 탱크 스프라이트는 포신이 밖으로 뻗어 차체보다 넓다."
  },

  "terrain": {
    "comment": "지형은 충돌에 관여하지 않는 배경이다. 이어 붙어야 하므로 스티커 테두리를 깎아 넣었다.",
    "grass": { "base": ["ground_lush_grass", "ground_dry_grass"] },
    "dirt": { "base": ["ground_dirt_clean_a", "ground_dirt_stones_b"] },
    "gravel": { "base": ["ground_scorched_a", "ground_scorched_b"] },
    "road": {
      "comment": "전용 도로 타일은 없다. 자갈길 무늬를 길로 쓴다. 그을린 바닥으로 깔았더니 검은 격자가 화면을 갈라 놓아 길이 아니라 흉터처럼 보였다.",
      "straightVertical": "ground_cracked_b",
      "straightHorizontal": "ground_cracked_b",
      "plain": ["ground_cracked_a", "ground_cracked_b"]
    }
  },

  "tiles": {
    "EMPTY": { "collision": "none", "bulletPass": true, "renderLayer": "ground" },

    "BRICK": {
      "collision": "block",
      "bulletPass": false,
      "destructible": true,
      "hp": 1,
      "renderLayer": "object",
      "sprites": ["brick_intact_a", "brick_intact_b", "brick_damage_1a", "brick_damage_1b"],
      "rubble": ["brick_rubble_a", "brick_rubble_b"],
      "comment": "셀 단위로 부서진다. 멀쩡한 벽 2종과 금 간 벽 2종을 섞어 벽면이 단조롭지 않게 한다."
    },

    "STEEL": {
      "collision": "block",
      "bulletPass": false,
      "destructible": "piercingOnly",
      "renderLayer": "object",
      "sprites": ["steel_clean_a", "steel_riveted_b", "steel_reinforced_a", "steel_reinforced_b"],
      "comment": "관통탄으로만 부술 수 있다."
    },

    "WATER": {
      "collision": "block",
      "bulletPass": true,
      "destructible": false,
      "renderLayer": "ground",
      "frames": ["water_frame_1", "water_frame_2", "water_frame_3", "water_frame_4"],
      "animFps": 4.0,
      "comment": "전용 프레임 4장이라 밝기 보정 없이 프레임 교대만으로 넘실거린다."
    },

    "FOREST": {
      "collision": "none",
      "bulletPass": true,
      "conceal": true,
      "renderLayer": "canopy",
      "sprites": ["forest_canopy_a", "forest_canopy_b", "forest_dense_a", "forest_dense_b"],
      "litter": ["bush_cluster", "rock_cluster"],
      "comment": "탱크 위 캐노피로 그려 원작의 숲 은폐를 재현한다."
    },

    "ICE": {
      "collision": "none",
      "bulletPass": true,
      "friction": 0.12,
      "renderLayer": "ground",
      "sprites": ["ice_clean_a", "ice_clean_b", "ice_cracked_a", "ice_cracked_b"],
      "comment": "전용 얼음 타일 4종. 물들이지 않고 그대로 쓴다."
    },

    "BASE": {
      "collision": "block",
      "bulletPass": false,
      "renderLayer": "object",
      "intact": "base_intact",
      "shielded": "base_shielded",
      "warnFrames": ["base_warning_1", "base_warning_2"],
      "warnFps": 4,
      "destroyFrames": ["base_damage_1", "base_damage_2", "base_destroyed"],
      "destroyFps": 6,
      "wreck": "base_rubble",
      "wallTile": "BRICK",
      "wallShape": "U",
      "comment": "정상 -> 손상 -> 심한 손상 -> 파괴 -> 잔해. 스프라이트가 블록보다 조금 커서 바닥을 블록 하단에 맞추고 위로 삐져나오게 그린다."
    },

    "SPAWN": { "collision": "none", "bulletPass": true, "renderLayer": "ground", "effect": "spawn" }
  },

  "tanks": {
    "atlas": "game",
    "comment": "위/오른쪽/아래/왼쪽이 미리 그려져 있다. 게임에서 회전시키지 않는다. 픽셀아트를 돌리면 가장자리가 뭉개지는데 그 문제가 통째로 사라진다.",
    "directions": ["up", "right", "down", "left"],
    "player": {
      "ATTACK": { "prefix": "player_attack", "color": "#F28A2E" },
      "DEFENSE": { "prefix": "player_defense", "color": "#35B9E6" },
      "SPEED": { "prefix": "player_speed", "color": "#9ACB2E" }
    },
    "enemy": {
      "ATTACK": { "prefix": "enemy_attack", "color": "#C8362C" },
      "DEFENSE": { "prefix": "enemy_defense", "color": "#4A6E90" },
      "SPEED": { "prefix": "enemy_speed", "color": "#7E8A3A" }
    },
    "slotMarker": {
      "sprite": "hud_heart_full",
      "sizeRatio": 0.34,
      "offsetRatio": -0.62,
      "colors": ["#35D2F0", "#F2922E", "#A6D62E", "#B45CE8"],
      "comment": "탱크 색은 종류가 정하므로 같은 종류를 고른 두 사람이 구별되지 않는다. 머리 위에 슬롯 색 표식을 띄운다. (P1 cyan / P2 orange / P3 lime / P4 violet)"
    }
  },

  "projectiles": {
    "atlas": "game",
    "normal": { "prefix": "shell_normal" },
    "piercing": { "prefix": "shell_piercing" },
    "muzzleFlash": { "prefix": "muzzle_flash", "lifetimeMs": 70 },
    "comment": "포탄도 방향별로 그려져 있다. 접미사는 탱크와 같은 up/right/down/left 다."
  },

  "effects": {
    "atlas": "game",
    "tankExplosion": {
      "frames": ["explosion_1", "explosion_2", "explosion_3", "explosion_4",
                 "explosion_5", "explosion_6", "explosion_7", "explosion_8"],
      "fps": 20
    },
    "bulletHit": { "frames": ["impact_small"], "fps": 24 },
    "brickBreak": { "frames": ["debris_brick"], "fps": 20 },
    "steelHit": { "frames": ["ricochet_steel"], "fps": 24 },
    "shieldHit": { "frames": ["shield_hit"], "fps": 24 },
    "spawn": { "frames": ["spawn_glow"], "fps": 10 },
    "shield": { "frames": ["shield_1", "shield_2", "shield_3"], "fps": 8 },
    "dash": { "frames": ["dash_trail_1", "dash_trail_2", "dash_trail_3"], "fps": 14 },
    "baseWarning": { "frames": ["base_warning_pulse"], "fps": 4 }
  },

  "props": {
    "comment": "EMPTY 블록에 확률 배치. kind=explosive 파괴 시 연쇄 폭발 / solid 충돌 / decor 충돌 없음.",
    "groups": {
      "fuelBarrel": { "kind": "explosive", "blastCells": 3, "sprites": ["barrel_hazard"] },
      "steelBarrel": { "kind": "explosive", "blastCells": 2, "sprites": ["barrel_steel"] },
      "supplyCrate": {
        "comment": "crate_broken 은 파괴 상태라 초기 배치에 쓰지 않는다 (가이드 §13).",
        "kind": "solid", "destructible": true, "hp": 1,
        "sprites": ["crate_intact"]
      },
      "sandbagLine": {
        "kind": "solid", "destructible": true, "hp": 1, "layout": "line",
        "sprites": ["sandbag_straight", "sandbag_corner"]
      },
      "rubble": { "kind": "decor", "sprites": ["brick_rubble_a", "brick_rubble_b"] },
      "scrub": { "kind": "decor", "sprites": ["rock_cluster", "bush_cluster"] }
    }
  },

  "hud": {
    "comment": "아이콘은 새 팩, 글자는 Kenney Desert Shooter 비트맵 폰트를 그대로 옮겨 왔다. 새 팩에 글자가 없다.",
    "life": "hud_heart_full",
    "lifeEmpty": "hud_heart_empty",
    "skull": "hud_enemy_counter",
    "kill": "hud_kill_explosion",
    "panel": "hud_status_panel",
    "dead": "hud_player_dead",
    "digitPrefix": "ui_digit_",
    "charPrefix": "ui_char_",
    "altDigitPrefix": "ui_alt_digit_",
    "altCharPrefix": "ui_alt_char_",
    "cooldown": {
      "comment": "특수기 쿨타임 고리. 한 장을 어둡게 깔고 차오른 만큼만 밝게 덧그린다.",
      "ring": "hud_cooldown_75"
    },
    "network": { "online": "hud_network_strong", "offline": "hud_network_disconnected" },
    "lobby": {
      "comment": "로비 화면 (계획서 §28).",
      "title": "lobby_title_plate",
      "slotByColor": [
        "lobby_player_slot_cyan", "lobby_player_slot_orange",
        "lobby_player_slot_lime", "lobby_player_slot_violet"
      ],
      "ready": "lobby_ready_badge",
      "waiting": "lobby_waiting_badge",
      "locked": "lobby_locked_badge",
      "host": "lobby_host_badge",
      "disconnected": "lobby_disconnected",
      "start": "lobby_primary_button_normal",
      "startPressed": "lobby_primary_button_pressed",
      "secondary": "lobby_secondary_button",
      "wifiStrong": "lobby_wifi_strong",
      "wifiWeak": "lobby_wifi_weak"
    },
    "controls": {
      "comment": "Phase 7 에서 쓴다. 지금은 그리지 않는다.",
      "joystickBase": "hud_joystick_base",
      "joystickKnob": "hud_joystick_knob",
      "fire": "hud_fire_button_normal",
      "firePressed": "hud_fire_button_pressed",
      "special": "hud_special_button_normal",
      "specialPressed": "hud_special_button_pressed"
    }
  }
}
