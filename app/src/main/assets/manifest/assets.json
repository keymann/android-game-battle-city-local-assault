      "descriptor": "atlas/tiles.xml",
      "type": "xml_subtexture",
      "sourceTile": 16,
      "comment": "16px 타일 660장 + 24px 이펙트 40장. 텍스처 1장으로 draw call 을 최소화한다.",
      "filter": "nearest"
